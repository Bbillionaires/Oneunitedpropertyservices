---
/**
 * "Built for Properties That Need to Perform." — property types as icon cards.
 * Cards lift and fill on hover; needs chips stagger in on reveal.
 */
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { propertyTypes } from '@/data/propertyTypes';
import { quoteHref } from '@/data/navigation';

interface Props {
  headingAs?: 'h1' | 'h2';
  showLink?: boolean;
}
const { headingAs = 'h2', showLink = true } = Astro.props;
---

<section id="property-types" class="ptypes section section--light" aria-labelledby="ptypes-title">
  <div class="container">
    <SectionHeading
      id="ptypes-title"
      as={headingAs}
      eyebrow="Who we serve"
      title={'Built for properties\nthat need to *perform.*'}
      lead="Every property type has its own standard. We build service around how yours operates — residents, tenants, customers, and owners all notice."
    />

    <ul class="ptypes__grid" role="list" data-reveal-group="80">
      {
        propertyTypes.map((p, i) => (
          <li class="ptype" data-reveal>
            <div class="ptype__top">
              <span class="ptype__icon">
                <Icon name={p.icon} size={28} />
              </span>
              <span class="ptype__num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="ptype__title">{p.title}</h3>
            <p class="ptype__blurb">{p.blurb}</p>
            <ul class="ptype__needs" role="list" aria-label={`Common needs for ${p.title}`}>
              {p.needs.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
            <a class="ptype__link" href={`${quoteHref}?property=${p.quoteValue === 'portfolio' ? 'other' : p.quoteValue}${p.quoteValue === 'portfolio' ? '&program=portfolio' : ''}`}>
              Request a quote <Icon name="arrowRight" size={16} />
              <span class="visually-hidden"> for {p.title}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      showLink && (
        <div class="ptypes__more" data-reveal>
          <a class="btn btn--outline-dark" href="/property-types/">
            Property types we serve <Icon name="arrowRight" size={18} />
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .ptypes__grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  }
  .ptype {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 600ms var(--ease-out),
      box-shadow 600ms var(--ease-out),
      color 400ms;
  }
  .ptype::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    clip-path: circle(0% at 2.9rem 2.9rem);
    transition: clip-path 800ms var(--ease-out);
  }
  .ptype__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .ptype__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--accent);
    transition:
      background 400ms,
      color 400ms;
  }
  .ptype__num {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--text-muted);
    transition: color 400ms;
  }
  .ptype__title {
    font-size: 1.35rem;
    text-transform: uppercase;
  }
  .ptype__blurb {
    color: var(--text-muted);
    transition: color 400ms;
  }
  .ptype__needs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
  .ptype__needs li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    transition: border-color 400ms;
  }
  .ptype__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent-ink);
  }
  .ptype__link::after {
    /* Whole card is clickable */
    content: '';
    position: absolute;
    inset: 0;
  }
  .ptype__link :global(.icon) {
    transition: transform var(--dur) var(--ease-out);
  }
  .ptype:is(:hover, :focus-within) {
    transform: translateY(-6px);
    box-shadow: 0 24px 50px rgba(13, 15, 18, 0.18);
    color: var(--white);
  }
  .ptype:is(:hover, :focus-within)::before {
    clip-path: circle(150% at 2.9rem 2.9rem);
  }
  .ptype:is(:hover, :focus-within) .ptype__icon {
    background: var(--accent);
    color: var(--ink);
  }
  .ptype:is(:hover, :focus-within) :is(.ptype__blurb, .ptype__num) {
    color: var(--text-on-dark-muted);
  }
  .ptype:is(:hover, :focus-within) .ptype__needs li {
    border-color: var(--line-dark);
  }
  .ptype:is(:hover, :focus-within) .ptype__link {
    color: var(--accent);
  }
  .ptype:is(:hover, :focus-within) .ptype__link :global(.icon) {
    transform: translateX(5px);
  }
  .ptypes__more {
    margin-top: 3rem;
  }
</style>
