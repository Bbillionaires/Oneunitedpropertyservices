---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceRows from '@/components/ServiceRows.astro';
import Programs from '@/components/Programs.astro';
import PortfolioCTA from '@/components/PortfolioCTA.astro';
import heroImg from '@/assets/projects/duval-landing/lawn-tree-line.jpg';
---

<BaseLayout
  title="Commercial Property Maintenance Services"
  description="Lawn and grounds care, weed and pesticide spraying, commercial pressure washing, painting, apartment turnovers, home cleaning and steaming, general maintenance, and EV charging station installation for multifamily and commercial properties in Jacksonville and Northeast Florida."
>
  <PageHero
    eyebrow="Services"
    title={'One team.\n*Multiple solutions.*'}
    lead="Complete property maintenance for apartment communities, multifamily, and commercial properties — scheduled, coordinated, and delivered by one team."
    image={heroImg}
    imageAlt="Mowed roadside lawn with fresh mulch rings around a row of trees at a Jacksonville community"
    crumbs={[{ label: 'Services' }]}
  />
  <ServiceRows />
  <Programs />
  <PortfolioCTA />
</BaseLayout>
