---
/**
 * "One-Time Projects & Recurring Property Care" — service programs.
 * Each card deep-links into the quote form with the program pre-selected.
 */
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { programs } from '@/data/programs';
import { quoteHref } from '@/data/navigation';

const cadences = [
  { label: 'Weekly', every: 1 },
  { label: 'Biweekly', every: 2 },
  { label: 'Monthly', every: 4 },
];
const weeks = Array.from({ length: 12 }, (_, i) => i);
---

<section id="programs" class="programs section section--paper" aria-labelledby="programs-title">
  <div class="container">
    <div class="programs__head">
      <SectionHeading
        id="programs-title"
        eyebrow="Service programs"
        title={'One-time projects &\n*recurring* property care.'}
      />
      <div class="programs__intro" data-reveal style="--reveal-delay:200">
        <p class="lead muted">
          Start with a single project or set up ongoing service. Recurring services can be customized according to the
          property’s requirements — services, frequency, and scope are built around how your property operates.
        </p>
      </div>
    </div>

    <ul class="programs__grid" role="list" data-reveal-group="100">
      {
        programs.map((p, i) => (
          <li data-reveal>
            <a class="program" href={`${quoteHref}?program=${p.id}`}>
              <span class="program__num">0{i + 1}</span>
              <span class="program__icon">
                <Icon name={p.icon} size={28} />
              </span>
              <h3 class="program__title">{p.title}</h3>
              <p class="program__desc">{p.description}</p>
              <span class="program__cta">
                Request this <Icon name="arrowRight" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="cadence" data-reveal aria-hidden="true">
      <div class="cadence__weeks">
        <span class="cadence__label"></span>
        {weeks.map((w) => <span class="cadence__wk">W{w + 1}</span>)}
      </div>
      {
        cadences.map((c, row) => (
          <div class="cadence__row">
            <span class="cadence__label">{c.label}</span>
            {weeks.map((w) => (
              <span class="cadence__cell">
                {w % c.every === 0 && <span class="cadence__dot" style={`--d:${row * 150 + w * 60}ms`} />}
              </span>
            ))}
          </div>
        ))
      }
    </div>

    <div class="programs__cta" data-reveal>
      <div>
        <h3 class="programs__cta-title">Not sure what your property needs?</h3>
        <p class="muted">Tell us about the property and we’ll recommend a plan around it.</p>
      </div>
      <a class="btn btn--dark" href={`${quoteHref}?program=custom`}>
        Build My Property Service Plan <Icon name="arrowRight" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .programs__head {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 960px) {
    .programs__head {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .programs__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }
  .programs__grid > li {
    display: flex;
  }
  .program {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    padding: 2rem 1.75rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 600ms var(--ease-out),
      box-shadow 600ms var(--ease-out),
      color 400ms var(--ease-out);
  }
  .program::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: translateY(101%);
    transition: transform 600ms var(--ease-out);
  }
  .program__num {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }
  .program__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--accent-ink);
    transition:
      background 400ms,
      color 400ms;
  }
  .program__title {
    font-size: 1.25rem;
    text-transform: uppercase;
  }
  .program__desc {
    color: var(--text-muted);
    flex: 1;
    transition: color 400ms;
  }
  .program__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .program__cta :global(.icon) {
    transition: transform var(--dur) var(--ease-out);
  }
  @media (hover: hover) {
    .program:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 50px rgba(13, 15, 18, 0.18);
      color: var(--white);
    }
    .program:hover::before {
      transform: none;
    }
    .program:hover .program__icon {
      background: var(--accent);
      color: var(--ink);
    }
    .program:hover :is(.program__desc, .program__num) {
      color: var(--text-on-dark-muted);
    }
    .program:hover .program__cta {
      color: var(--accent);
    }
    .program:hover .program__cta :global(.icon) {
      transform: translateX(5px);
    }
  }

  /* Recurring cadence visual */
  .cadence {
    display: grid;
    gap: 0.6rem;
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }
  .cadence__weeks,
  .cadence__row {
    display: grid;
    grid-template-columns: 6rem repeat(12, minmax(1.75rem, 1fr));
    align-items: center;
    gap: 0.35rem;
    min-width: 34rem;
  }
  .cadence__wk {
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--text-muted);
    text-align: center;
  }
  .cadence__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cadence__cell {
    display: grid;
    place-items: center;
    height: 2rem;
    border-radius: 4px;
    background: var(--paper);
  }
  .cadence__dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
  }
  :global(.motion-ok) .cadence__dot {
    transform: scale(0);
    transition: transform 600ms var(--ease-out);
    transition-delay: var(--d);
  }
  :global(.motion-ok) .cadence:global(.is-in) .cadence__dot {
    transform: scale(1);
  }

  .programs__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .programs__cta-title {
    font-size: var(--fs-xl);
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  @media (max-width: 520px) {
    .programs__cta .btn {
      width: 100%;
    }
  }
</style>
