---
/**
 * Services index: one block per service. Text-first; a real project photo is
 * shown only when the service has one.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '@/data/services';
import { quoteHref } from '@/data/navigation';
---

<section class="rows section section--paper" aria-label="Our services">
  <div class="container rows__list">
    {
      services.map((s, i) => (
        <article class:list={['row', { 'row--photo': s.image }]} id={s.slug}>
          <div class="row__head">
            <span class="row__num" data-reveal="fade">{String(i + 1).padStart(2, '0')}</span>
            <span class="row__icon" data-reveal="scale">
              <Icon name={s.icon} size={26} />
            </span>
            <h2 class="h2 row__title" data-reveal>{s.title}</h2>
            <p class="lead muted" data-reveal style="--reveal-delay:100">{s.intro}</p>
            <div class="row__actions" data-reveal>
              <a class="btn btn--dark" href={`/services/${s.slug}/`}>
                Learn more <Icon name="arrowRight" size={18} />
              </a>
              <a class="link-arrow" href={`${quoteHref}?service=${s.quoteValue}`}>
                Get a quote <Icon name="arrowRight" size={16} />
              </a>
            </div>
          </div>
          <div class="row__side">
            {s.image && (
              <div class="row__media" data-reveal="image">
                <Image src={s.image} alt={s.imageAlt ?? ''} widths={[640, 960]} sizes="(min-width: 960px) 40vw, 100vw" loading="lazy" />
              </div>
            )}
            <ul class="row__scope" role="list" data-reveal-group="50">
              {s.scope.map((item) => (
                <li data-reveal>
                  <Icon name="check" size={16} strokeWidth={2.2} />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .rows__list {
    display: grid;
  }
  .row {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line);
  }
  .row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .row__head {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    align-content: start;
  }
  .row__num {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent-ink);
  }
  .row__icon {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--accent);
  }
  .row__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.5rem;
  }
  .row__actions .link-arrow {
    color: var(--accent-ink);
  }
  .row__side {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .row__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .row__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row__scope {
    display: grid;
    gap: 0;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 0.5rem 1.5rem;
  }
  .row__scope li {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
  }
  .row__scope li:last-child {
    border-bottom: 0;
  }
  .row__scope :global(.icon) {
    color: var(--accent-ink);
    flex: none;
  }
  @media (min-width: 960px) {
    .row {
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
</style>
