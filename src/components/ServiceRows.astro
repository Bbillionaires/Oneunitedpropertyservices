---
/** Alternating image/text rows — one per service — for the services index. */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '@/data/services';
import { quoteHref } from '@/data/navigation';
---

<section class="rows section section--paper" aria-label="Our services">
  <div class="container rows__list">
    {
      services.map((s, i) => (
        <article class:list={['row', { 'row--flip': i % 2 === 1 }]} id={s.slug}>
          <div class="row__media" data-reveal="image">
            <Image src={s.image} alt={s.imageAlt} widths={[640, 960, 1280]} sizes="(min-width: 960px) 55vw, 100vw" loading="lazy" />
            <span class="row__num">0{i + 1}</span>
          </div>
          <div class="row__body">
            <span class="row__icon" data-reveal="scale">
              <Icon name={s.icon} size={26} />
            </span>
            <h2 class="h2" data-reveal>{s.title}</h2>
            <p class="lead muted" data-reveal style="--reveal-delay:100">{s.intro}</p>
            <ul class="row__scope" role="list" data-reveal-group="50">
              {s.scope.slice(0, 4).map((item) => (
                <li data-reveal>
                  <Icon name="check" size={16} strokeWidth={2.2} />
                  {item}
                </li>
              ))}
            </ul>
            <div class="row__actions" data-reveal>
              <a class="btn btn--dark" href={`/services/${s.slug}/`}>
                Explore {s.shortTitle} <Icon name="arrowRight" size={18} />
              </a>
              <a class="link-arrow" href={`${quoteHref}?service=${s.quoteValue}`}>
                Get a quote <Icon name="arrowRight" size={16} />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .rows__list {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
  }
  .row {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .row__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .row__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row__num {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .row__body {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .row__icon {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
  }
  .row__scope {
    display: grid;
    gap: 0.5rem 1.5rem;
    width: 100%;
  }
  .row__scope li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-weight: 600;
  }
  .row__scope :global(.icon) {
    color: var(--accent-ink);
    flex: none;
  }
  .row__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.5rem;
  }
  .row__actions .link-arrow {
    color: var(--accent-ink);
  }
  @media (min-width: 640px) {
    .row__scope {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 960px) {
    .row {
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
    .row--flip .row__media {
      order: 2;
    }
  }
</style>
