---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BeforeAfterSection from '@/components/BeforeAfterSection.astro';
import CtaBand from '@/components/CtaBand.astro';
---

<BaseLayout
  title="Before & After"
  description="Real before and after photos from One United jobs in Jacksonville — lawns cut and edged, driveways, walkways, and fences pressure washed."
>
  <PageHero
    eyebrow="Before & after"
    title={'See the *difference.*'}
    lead="Real One United jobs in Jacksonville. Finished work first."
    crumbs={[{ label: 'Before & After' }]}
    compact
  />
  <BeforeAfterSection showLink={false} />
  <CtaBand />
</BaseLayout>
