---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PropertyTypes from '@/components/PropertyTypes.astro';
import WhyOneUnited from '@/components/WhyOneUnited.astro';
import PortfolioCTA from '@/components/PortfolioCTA.astro';
---

<BaseLayout
  title="Property Types We Serve"
  description="Property maintenance for apartment communities, multifamily properties, residential properties, commercial buildings, gas stations, retail, office, HOAs, and real estate portfolios in Jacksonville and Northeast Florida."
>
  <PageHero
    eyebrow="Property types"
    title={'Built for properties\nthat need to *perform.*'}
    lead="Apartment communities, multifamily, residential, commercial, gas stations, retail, office, HOAs, and portfolios — each with its own standard. We build service around yours."
    crumbs={[{ label: 'Property Types' }]}
    compact
  />
  <PropertyTypes showLink={false} />
  <WhyOneUnited />
  <PortfolioCTA />
</BaseLayout>
