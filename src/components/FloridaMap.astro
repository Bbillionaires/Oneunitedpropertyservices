---
/**
 * Stylized Florida outline with animated markers for each service area in
 * src/data/serviceAreas.ts. The outline is a simplified, illustrative trace —
 * not a survey-accurate map.
 */
import { serviceAreas } from '@/data/serviceAreas';

// Simplified state outline as [lon, lat] points (clockwise from the NW corner).
const outline: [number, number][] = [
  [-87.6, 31.0], [-85.0, 31.0], [-85.0, 30.75], [-84.86, 30.7], [-83.5, 30.65], [-82.2, 30.57],
  [-82.04, 30.75], [-81.45, 30.71], [-81.4, 30.3], [-81.25, 29.8], [-81.1, 29.4], [-80.9, 29.0],
  [-80.6, 28.6], [-80.55, 28.1], [-80.35, 27.6], [-80.1, 27.0], [-80.04, 26.5], [-80.1, 25.9],
  [-80.25, 25.55], [-80.45, 25.2], [-80.9, 25.13], [-81.15, 25.35], [-81.35, 25.8], [-81.75, 26.1],
  [-81.95, 26.5], [-82.2, 26.75], [-82.45, 27.2], [-82.7, 27.5], [-82.65, 27.95], [-82.85, 28.2],
  [-82.7, 28.7], [-82.75, 29.05], [-83.05, 29.15], [-83.4, 29.5], [-83.7, 29.9], [-84.05, 30.1],
  [-84.35, 29.95], [-84.9, 29.7], [-85.35, 29.68], [-85.5, 29.95], [-85.9, 30.2], [-86.4, 30.4],
  [-87.0, 30.38], [-87.45, 30.3], [-87.5, 30.6], [-87.6, 31.0],
];

const W = 600; // map drawing area
const H = 560;
const VW = 790; // extra room on the right for labels
const lonMin = -87.8;
const lonMax = -79.8;
const latMin = 24.9;
const latMax = 31.2;
const k = Math.cos((28 * Math.PI) / 180);
const scale = Math.min((W - 40) / ((lonMax - lonMin) * k), (H - 40) / (latMax - latMin));
const project = ([lon, lat]: [number, number]) => [20 + (lon - lonMin) * k * scale, 20 + (latMax - lat) * scale] as const;

const d = outline.map((p, i) => `${i ? 'L' : 'M'}${project(p).map((n) => n.toFixed(1)).join(' ')}`).join(' ') + 'Z';
const milesPerDegLat = 69;
const markers = serviceAreas.map((a) => {
  const [x, y] = project(a.coords);
  return { ...a, x, y, r: (a.radiusMiles / milesPerDegLat) * scale };
});
---

<svg class="fl-map" viewBox={`0 0 ${VW} ${H}`} role="img" aria-labelledby="fl-map-title">
  <title id="fl-map-title">
    Map of Florida highlighting {serviceAreas.map((a) => `${a.name} (${a.region})`).join(', ')}
  </title>
  <defs>
    <pattern id="fl-dots" width="9" height="9" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1.3" class="fl-map__dot"></circle>
    </pattern>
    <clipPath id="fl-clip"><path d={d}></path></clipPath>
  </defs>
  <rect width={W} height={H} fill="url(#fl-dots)" clip-path="url(#fl-clip)"></rect>
  <path d={d} class="fl-map__outline" pathLength="1"></path>
  {
    markers.map((m) => (
      <g class:list={['fl-map__marker', `is-${m.status}`]}>
        <circle cx={m.x} cy={m.y} r={m.r} class="fl-map__area" />
        <circle cx={m.x} cy={m.y} r={m.r} class="fl-map__ring" />
        <circle cx={m.x} cy={m.y} r={m.r} class="fl-map__ring fl-map__ring--2" />
        <circle cx={m.x} cy={m.y} r="7" class="fl-map__pin" />
        <line x1={m.x + 10} y1={m.y} x2={m.x + 60} y2={m.y} class="fl-map__leader" />
        <text x={m.x + 68} y={m.y - 4} class="fl-map__name">{m.name}</text>
        <text x={m.x + 68} y={m.y + 14} class="fl-map__region">{m.region}</text>
      </g>
    ))
  }
</svg>

<style>
  .fl-map {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .fl-map__dot {
    fill: rgba(255, 255, 255, 0.22);
  }
  .fl-map__outline {
    fill: none;
    stroke: rgba(255, 255, 255, 0.55);
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }
  :global(.motion-ok) .fl-map__outline {
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 2600ms var(--ease-in-out);
  }
  :global(.motion-ok) :global(.is-in) > .fl-map .fl-map__outline {
    stroke-dashoffset: 0;
  }
  .fl-map__area {
    fill: rgba(216, 162, 62, 0.22);
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  .fl-map__ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  :global(.motion-ok) .fl-map__ring {
    animation: ring 3.6s var(--ease-out) infinite;
  }
  :global(.motion-ok) .fl-map__ring--2 {
    animation-delay: 1.8s;
  }
  @keyframes ring {
    0% {
      opacity: 0.8;
      transform: scale(0.3);
    }
    100% {
      opacity: 0;
      transform: scale(1.8);
    }
  }
  .fl-map__pin {
    fill: var(--accent);
    stroke: var(--ink);
    stroke-width: 3;
  }
  .fl-map__leader {
    stroke: rgba(255, 255, 255, 0.6);
    stroke-width: 1;
  }
  .fl-map__name {
    fill: var(--white);
    font-size: 22px;
    font-weight: 800;
    font-stretch: 112%;
    text-transform: uppercase;
  }
  .fl-map__region {
    fill: var(--accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  :global(.motion-ok) .fl-map__marker {
    opacity: 0;
    transition: opacity 900ms var(--ease-out) 1400ms;
  }
  :global(.motion-ok) :global(.is-in) > .fl-map .fl-map__marker {
    opacity: 1;
  }
</style>
