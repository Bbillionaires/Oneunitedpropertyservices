---
/**
 * Side-by-side before/after for photos that do NOT show the exact same view
 * (e.g. washed vs. unwashed sections of the same job). A drag slider would
 * imply identical framing, so these are shown as two labelled photos.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  sizes?: string;
}
const { before, after, beforeAlt, afterAlt, sizes = '(min-width: 1100px) 320px, 50vw' } = Astro.props;
---

<div class="pair">
  <figure class="pair__item">
    <Image src={before} alt={beforeAlt} widths={[400, 700, 1000]} sizes={sizes} loading="lazy" />
    <figcaption class="pair__tag">Before</figcaption>
  </figure>
  <figure class="pair__item">
    <Image src={after} alt={afterAlt} widths={[400, 700, 1000]} sizes={sizes} loading="lazy" />
    <figcaption class="pair__tag pair__tag--after">After</figcaption>
  </figure>
</div>

<style>
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    width: 100%;
    max-width: 640px;
  }
  .pair__item {
    position: relative;
    margin: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--charcoal-2);
  }
  .pair__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1200ms var(--ease-out);
  }
  .pair__item:hover :global(img) {
    transform: scale(1.04);
  }
  .pair__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgba(13, 15, 18, 0.72);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .pair__tag--after {
    background: var(--accent);
    color: var(--ink);
  }
</style>
