# Quote form delivery (used by src/pages/api/quote.ts on Vercel).
# Set these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
# Inbox(es) that receive quote requests, comma-separated.
QUOTE_TO_EMAIL=
# Sender on a domain verified in Resend.
QUOTE_FROM_EMAIL="One United Quotes <quotes@send.oneunitedpropertyservices.com>"

# Optional: send the form somewhere other than /api/quote (CRM webhook, etc.).
PUBLIC_QUOTE_ENDPOINT=
