---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BeforeAfterSlider from '@/components/BeforeAfterSlider.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { comparisons } from '@/data/beforeAfter';

const hasPlaceholders = comparisons.some((c) => c.placeholder);
---

<BaseLayout
  title="Before & After"
  description="See the difference professional pressure washing, painting, landscaping, cleanup, and turnover services make on multifamily and commercial properties."
>
  <PageHero
    eyebrow="Before & after"
    title={'See the *difference.*'}
    lead="Drag any slider to compare. Pressure washing, painting, landscaping, property cleanup, and unit turnovers."
    crumbs={[{ label: 'Before & After' }]}
    compact
  />

  <section class="section section--dark gallery">
    <div class="container">
      {
        hasPlaceholders && (
          <p class="gallery__note" data-reveal>
            <Icon name="info" size={18} />
            <span>
              The comparisons below are <strong>simulated placeholders</strong> created from stock photography to
              demonstrate this feature. They will be replaced with real One United project photos.
            </span>
          </p>
        )
      }
      <ul class="gallery__grid" role="list">
        {
          comparisons.map((c, i) => (
            <li class="gallery__item" data-reveal>
              <BeforeAfterSlider
                before={c.before}
                after={c.after}
                beforeAlt={c.beforeAlt}
                afterAlt={c.afterAlt}
                label={`${c.category}: ${c.title}`}
                placeholder={c.placeholder}
                sizes={i === 0 ? '(min-width: 1100px) 1320px, 100vw' : '(min-width: 960px) 50vw, 100vw'}
              />
              <div class="gallery__caption">
                <span class="gallery__cat">{c.category}</span>
                <h2>{c.title}</h2>
                <p class="muted">{c.caption}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .gallery {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .gallery__note {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    max-width: 70ch;
    margin-bottom: 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px dashed rgba(216, 162, 62, 0.6);
    border-radius: var(--radius);
    color: var(--text-on-dark-muted);
    font-size: var(--fs-sm);
  }
  .gallery__note :global(.icon) {
    flex: none;
    color: var(--accent);
    margin-top: 0.1rem;
  }
  .gallery__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem) 2rem;
  }
  .gallery__caption {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.1rem;
  }
  .gallery__cat {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .gallery__caption h2 {
    font-size: var(--fs-xl);
  }
  @media (min-width: 960px) {
    .gallery__grid {
      grid-template-columns: 1fr 1fr;
    }
    .gallery__item:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
