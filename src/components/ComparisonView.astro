---
/** Renders a comparison as a drag slider (same view) or a side-by-side pair. */
import BeforeAfterSlider from './BeforeAfterSlider.astro';
import BeforeAfterPair from './BeforeAfterPair.astro';
import type { Comparison } from '@/data/beforeAfter';

interface Props {
  comparison: Comparison;
  sizes?: string;
}
const { comparison: c, sizes } = Astro.props;
---

{
  c.sameView === false ? (
    <BeforeAfterPair before={c.before} after={c.after} beforeAlt={c.beforeAlt} afterAlt={c.afterAlt} />
  ) : (
    <BeforeAfterSlider
      before={c.before}
      after={c.after}
      beforeAlt={c.beforeAlt}
      afterAlt={c.afterAlt}
      label={`${c.category}: ${c.title}`}
      placeholder={c.placeholder}
      sizes={sizes}
    />
  )
}
