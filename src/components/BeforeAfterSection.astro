---
/**
 * "See the Difference" — real job photos. After photos lead and are larger;
 * before photos follow, smaller and muted. Data: src/data/gallery.ts.
 */
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { afterPhotos, beforePhotos, galleryCaption } from '@/data/gallery';

interface Props {
  showLink?: boolean;
  headingAs?: 'h1' | 'h2';
}
const { showLink = true, headingAs = 'h2' } = Astro.props;
---

<section id="before-after" class="see section section--dark" aria-labelledby="see-title">
  <div class="see__glow" aria-hidden="true"></div>
  <div class="container">
    <SectionHeading
      id="see-title"
      as={headingAs}
      eyebrow="Before & After"
      title={'See the *Difference.*'}
      lead="Real results from our work in Jacksonville — cut, edged, and pressure washed."
    />

    <div class="see__group">
      <h3 class="see__label see__label--after"><span>After</span></h3>
      <ul class="after-grid" role="list" data-reveal-group="90">
        {
          afterPhotos.map((p, i) => (
            <li class:list={['after-grid__item', { 'after-grid__item--lead': i === 0 }]} data-reveal="scale">
              <Image
                src={p.image}
                alt={`After: ${p.alt}`}
                widths={i === 0 ? [640, 960, 1400] : [480, 720]}
                sizes={i === 0 ? '(min-width: 960px) 50vw, 100vw' : '(min-width: 960px) 25vw, 50vw'}
                loading="lazy"
              />
              <span class="tag tag--after" aria-hidden="true">After</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="see__group see__group--before">
      <h3 class="see__label see__label--before"><span>Before</span></h3>
      <ul class="before-grid" role="list" data-reveal-group="60">
        {
          beforePhotos.map((p) => (
            <li class="before-grid__item" data-reveal>
              <Image src={p.image} alt={`Before: ${p.alt}`} widths={[320, 480]} sizes="(min-width: 960px) 16vw, 33vw" loading="lazy" />
              <span class="tag tag--before" aria-hidden="true">Before</span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="see__caption">{galleryCaption}</p>

    {
      showLink && (
        <div class="see__more" data-reveal>
          <a class="btn" href="/quote/">
            Get this for your property <Icon name="arrowRight" size={18} />
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .see {
    overflow: hidden;
  }
  .see__glow {
    position: absolute;
    width: 60vw;
    height: 60vw;
    max-width: 900px;
    max-height: 900px;
    right: -20vw;
    top: -10vw;
    background: radial-gradient(circle, rgba(216, 162, 62, 0.16), transparent 65%);
    pointer-events: none;
  }
  :global(.motion-ok) .see__glow {
    animation: glow-drift 18s ease-in-out infinite alternate;
  }
  @keyframes glow-drift {
    to {
      transform: translate(-18vw, 20vw);
    }
  }
  .see__group {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .see__label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    font-stretch: 112%;
  }
  .see__label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line-dark);
  }
  .see__label--after {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem);
    color: var(--accent);
  }
  .see__label--before {
    font-size: 1rem;
    letter-spacing: 0.16em;
    color: var(--text-on-dark-muted);
  }

  /* After: big, bright, first */
  .after-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, 1fr);
  }
  .after-grid__item {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--charcoal-2);
    box-shadow: 0 0 0 2px rgba(216, 162, 62, 0.55);
  }
  .after-grid__item--lead {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
  }
  .after-grid__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1200ms var(--ease-out);
  }
  .after-grid__item:hover :global(img) {
    transform: scale(1.05);
  }
  @media (min-width: 960px) {
    .after-grid {
      grid-template-columns: 2fr 1fr 1fr;
      grid-auto-rows: 1fr;
    }
    .after-grid__item {
      aspect-ratio: auto;
      min-height: 15rem;
    }
    .after-grid__item--lead {
      grid-column: 1;
      grid-row: 1 / span 2;
      aspect-ratio: auto;
    }
  }

  /* Before: smaller, muted */
  .before-grid {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(3, 1fr);
  }
  @media (min-width: 960px) {
    .before-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  .before-grid__item {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .before-grid__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.55) brightness(0.8);
    transition: filter 500ms var(--ease-out);
  }
  .before-grid__item:hover :global(img) {
    filter: none;
  }

  .tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .tag--after {
    background: var(--accent);
    color: var(--ink);
    font-size: 0.78rem;
    padding: 0.45rem 0.9rem;
  }
  .tag--before {
    top: 0.45rem;
    left: 0.45rem;
    padding: 0.2rem 0.5rem;
    font-size: 0.58rem;
    background: rgba(13, 15, 18, 0.75);
    color: var(--white);
  }
  .see__caption {
    margin-top: 1.25rem;
    font-size: var(--fs-sm);
    color: var(--text-on-dark-muted);
  }
  .see__more {
    margin-top: 2.25rem;
  }
</style>
