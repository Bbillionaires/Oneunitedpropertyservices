---
import { site } from '@/data/site';
import { primaryArea } from '@/data/serviceAreas';

export interface SEOProps {
  title: string;
  description?: string;
  /** Absolute or root-relative path to a 1200×630 social image. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = '/og-image.jpg',
  imageAlt = `${site.name} — ${site.tagline}`,
  noindex = false,
  type = 'website',
  schema = [],
} = Astro.props as SEOProps;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const imageURL = new URL(image, Astro.site ?? site.url).href;
const fullTitle = title === site.name ? `${site.name} | Commercial & Multifamily Property Maintenance` : `${title} | ${site.name}`;

// Only verified facts go into structured data — placeholders are excluded.
const contactPoint = Object.values(site.contact).some((c) => !c.placeholder);
const organization: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  slogan: site.tagline,
  description: site.description,
  parentOrganization: { '@type': 'Organization', name: site.parent },
  areaServed: { '@type': 'Place', name: `${primaryArea.name}, ${primaryArea.region}` },
};
if (contactPoint && !site.contact.phone.placeholder) organization.telephone = site.contact.phone.value;
if (contactPoint && !site.contact.email.placeholder) organization.email = site.contact.email.value;

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  publisher: { '@id': `${site.url}/#organization` },
};

const graph = [organization, website, ...schema];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
