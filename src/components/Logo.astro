---
/**
 * Brand lockup: mark + "ONE UNITED / PROPERTY SERVICES".
 * The mark is a roofline over a single upright — one structure, one team.
 */
interface Props {
  showParent?: boolean;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { showParent = false, size = 'md', class: className } = Astro.props;
---

<span class:list={['logo', `logo--${size}`, className]}>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <rect x="1.5" y="1.5" width="45" height="45" rx="3" fill="none" stroke="currentColor" stroke-width="3"></rect>
    <path d="M10 22 24 11l14 11" fill="none" stroke="var(--accent)" stroke-width="4" stroke-linecap="square"></path>
    <path d="M21 21h6v17h-6z" fill="currentColor"></path>
    <path d="M18 24l3-3" stroke="currentColor" stroke-width="3"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__primary">One United</span>
    <span class="logo__secondary">Property Services</span>
    {showParent && <span class="logo__parent">A One United Enterprise Company</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    color: inherit;
    line-height: 1;
  }
  .logo__mark {
    width: 2.6em;
    height: 2.6em;
    flex: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.28em;
  }
  .logo__primary {
    font-weight: 800;
    font-stretch: 118%;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.18em;
  }
  .logo__secondary {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.62em;
    opacity: 0.82;
  }
  .logo__parent {
    margin-top: 0.4em;
    font-size: 0.6em;
    letter-spacing: 0.06em;
    opacity: 0.65;
  }
  .logo--sm { font-size: 0.85rem; }
  .logo--md { font-size: 1rem; }
  .logo--lg { font-size: 1.35rem; }
</style>
