# Quote form delivery (used by src/pages/api/quote.ts on Vercel).
# Set these in Vercel → Project → Settings → Environment Variables.

# Google Workspace mailbox that sends the quote emails.
GMAIL_USER=solutions@oneunitedpropertyservices.com
# A Google App Password for that mailbox (Google Account → Security → App passwords).
GMAIL_APP_PASSWORD=
# Optional override: where requests are delivered (comma-separated).
# Defaults to solutions@oneunitedpropertyservices.com.
QUOTE_TO_EMAIL=

# Optional: send the form somewhere other than /api/quote (CRM webhook, etc.).
PUBLIC_QUOTE_ENDPOINT=
