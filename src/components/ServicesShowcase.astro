---
/**
 * "One Team. Multiple Solutions." — animated service list.
 * Text-first by design: services are listed, not illustrated with stock.
 * Reads from src/data/services.ts, so new services appear automatically.
 */
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { services } from '@/data/services';
---

<section id="services" class="services section section--paper" aria-labelledby="services-title">
  <div class="container">
    <div class="services__head">
      <SectionHeading id="services-title" eyebrow="What we do" title={'One Team.\n*Multiple Solutions.*'} />
      <p class="lead muted services__lead" data-reveal style="--reveal-delay:200">
        {services.length} property services under one relationship — scheduled, coordinated, and held to one standard
        across your property.
      </p>
    </div>

    <ul class="svc-list" role="list" data-reveal-group="70">
      {
        services.map((s, i) => (
          <li class="svc" data-reveal>
            <a class="svc__link" href={`/services/${s.slug}/`}>
              <span class="svc__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc__icon">
                <Icon name={s.icon} size={26} />
              </span>
              <div class="svc__text">
                <h3 class="svc__title">{s.title}</h3>
                <p class="svc__summary">{s.summary}</p>
              </div>
              <span class="svc__arrow" aria-hidden="true">
                <Icon name="arrowUpRight" size={22} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__head {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 960px) {
    .services__head {
      grid-template-columns: 1.3fr 1fr;
    }
    .services__lead {
      justify-self: end;
      max-width: 34ch;
    }
  }

  .svc-list {
    border-top: 1px solid var(--line);
  }
  .svc {
    border-bottom: 1px solid var(--line);
  }
  .svc__link {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem 1.25rem;
    padding: 1.5rem 0.25rem;
    text-decoration: none;
    isolation: isolate;
    overflow: hidden;
  }
  /* Ink fill sweeps in from the left on hover/focus */
  .svc__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms var(--ease-out);
  }
  .svc__num {
    display: none;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    transition: color 400ms;
  }
  .svc__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--accent-ink);
    transition:
      background 400ms,
      color 400ms,
      border-color 400ms,
      transform 600ms var(--ease-out);
  }
  .svc__text {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .svc__title {
    font-size: clamp(1.25rem, 1rem + 1.4vw, 2.1rem);
    text-transform: uppercase;
    transition:
      color 400ms,
      transform 600ms var(--ease-out);
  }
  .svc__summary {
    color: var(--text-muted);
    max-width: 62ch;
    transition: color 400ms;
  }
  .svc__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition:
      transform 600ms var(--ease-out),
      background 400ms,
      border-color 400ms,
      color 400ms;
  }

  .svc__link:is(:hover, :focus-visible)::before {
    transform: scaleX(1);
  }
  .svc__link:is(:hover, :focus-visible) .svc__title {
    color: var(--white);
    transform: translateX(6px);
  }
  .svc__link:is(:hover, :focus-visible) :is(.svc__summary, .svc__num) {
    color: var(--text-on-dark-muted);
  }
  .svc__link:is(:hover, :focus-visible) .svc__icon {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
    transform: rotate(-10deg) scale(1.06);
  }
  .svc__link:is(:hover, :focus-visible) .svc__arrow {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
    transform: rotate(45deg);
  }
  .svc__link:focus-visible {
    outline-offset: -3px;
  }

  @media (min-width: 768px) {
    .svc__link {
      grid-template-columns: 3rem auto 1fr auto;
      gap: 1.5rem 2rem;
      padding: 2rem 1.5rem;
    }
    .svc__num {
      display: block;
    }
  }
  @media (max-width: 520px) {
    .svc__arrow {
      display: none;
    }
    .svc__link {
      grid-template-columns: auto 1fr;
      align-items: start;
    }
  }
</style>
