---
/**
 * Reusable before/after comparison.
 * Drag, click, touch, or use the keyboard (arrow keys / Home / End) — the
 * control is a native range input, so it is accessible by default.
 *
 * <BeforeAfterSlider before={img} after={img} beforeAlt="…" afterAlt="…" />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  label?: string;
  placeholder?: boolean;
  start?: number;
  sizes?: string;
  eager?: boolean;
}

const {
  before,
  after,
  beforeAlt,
  afterAlt,
  label = 'Before and after comparison',
  placeholder = false,
  start = 50,
  sizes = '(min-width: 1100px) 640px, 100vw',
  eager = false,
} = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<div class="ba" style={`--pos:${start}%;aspect-ratio:${after.width} / ${after.height}`} data-ba>
  <Image class="ba__img ba__img--after" src={after} alt={afterAlt} widths={[640, 1000, 1500]} sizes={sizes} loading={loading} />
  <div class="ba__before">
    <Image class="ba__img" src={before} alt={beforeAlt} widths={[640, 1000, 1500]} sizes={sizes} loading={loading} />
  </div>

  <span class="ba__tag ba__tag--before" aria-hidden="true">Before</span>
  <span class="ba__tag ba__tag--after" aria-hidden="true">After</span>

  <div class="ba__handle" aria-hidden="true">
    <span class="ba__knob"><Icon name="drag" size={20} strokeWidth={2} /></span>
  </div>

  <input
    class="ba__range"
    type="range"
    min="0"
    max="100"
    step="1"
    value={start}
    aria-label={`${label}: drag to reveal before (left) and after (right)`}
    aria-valuetext={`${start}% before shown`}
  />

  {
    placeholder && (
      <span class="ba__disclaimer">
        <Icon name="info" size={14} /> Illustrative image, not a One United project
      </span>
    )
  }
</div>

<style>
  .ba {
    --pos: 50%;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--charcoal-2);
    user-select: none;
    touch-action: pan-y;
  }
  .ba :global(.ba__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba:not(.is-dragging) .ba__before,
  .ba:not(.is-dragging) .ba__handle {
    transition:
      clip-path 600ms var(--ease-out),
      left 600ms var(--ease-out);
  }
  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--white);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
    pointer-events: none;
  }
  .ba__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.35);
    transform: translate(-50%, -50%);
    transition: transform var(--dur) var(--ease-out);
  }
  .ba:hover .ba__knob,
  .ba.is-dragging .ba__knob {
    transform: translate(-50%, -50%) scale(1.1);
  }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
  }
  .ba:has(.ba__range:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .ba__tag {
    position: absolute;
    top: 1rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgba(13, 15, 18, 0.72);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    pointer-events: none;
    transition: opacity var(--dur);
  }
  .ba__tag--before {
    left: 1rem;
  }
  .ba__tag--after {
    right: 1rem;
    background: var(--accent);
    color: var(--ink);
  }
  .ba__disclaimer {
    position: absolute;
    left: 50%;
    bottom: 0.9rem;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: calc(100% - 2rem);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(13, 15, 18, 0.78);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    pointer-events: none;
  }
</style>

<script>
  import { motionAllowed } from '@/scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('.ba__range');
    if (!range) return;
    const set = (v: number) => {
      root.style.setProperty('--pos', `${v}%`);
      range.setAttribute('aria-valuetext', `${Math.round(v)}% before shown`);
    };
    range.addEventListener('input', () => {
      root.classList.add('is-dragging');
      set(Number(range.value));
    });
    const release = () => root.classList.remove('is-dragging');
    range.addEventListener('change', release);
    range.addEventListener('pointerup', release);
    range.addEventListener('keyup', release);

    // A short "sweep" hint the first time the slider scrolls into view.
    if (!motionAllowed()) return;
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        const start = Number(range.value);
        const seq = [start + 22, start - 18, start];
        seq.forEach((v, i) =>
          setTimeout(() => {
            if (root.classList.contains('is-dragging')) return;
            range.value = String(v);
            set(v);
          }, 350 + i * 650),
        );
      },
      { threshold: 0.6 },
    );
    io.observe(root);
  });
</script>
