---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PropertyTypes from '@/components/PropertyTypes.astro';
import WhyOneUnited from '@/components/WhyOneUnited.astro';
import PortfolioCTA from '@/components/PortfolioCTA.astro';
import heroImg from '@/assets/placeholders/apartment-palms.jpg';
---

<BaseLayout
  title="Property Types We Serve"
  description="Property maintenance for apartment communities, multifamily properties, commercial buildings, retail, office, HOAs, and real estate portfolios in Jacksonville and Northeast Florida."
>
  <PageHero
    eyebrow="Property types"
    title={'Built for properties\nthat need to *perform.*'}
    lead="Apartment communities, multifamily, commercial, retail, office, HOAs, and portfolios — each with its own standard. We build service around yours."
    image={heroImg}
    imageAlt="White mid-rise apartment community with balconies and palm trees"
    crumbs={[{ label: 'Property Types' }]}
  />
  <PropertyTypes showLink={false} />
  <WhyOneUnited />
  <PortfolioCTA />
</BaseLayout>
